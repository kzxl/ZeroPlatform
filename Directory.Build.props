<Project>
  <PropertyGroup>
    <Authors>Phong Võ, ZeroUniverse Contributors</Authors>
    <Company>ZeroUniverse</Company>
    <Copyright>Copyright © 2026 ZeroUniverse</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kzxl/ZeroPlatform.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/kzxl/ZeroPlatform</PackageProjectUrl>
    <LangVersion>latest</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
