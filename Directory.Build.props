<Project>
  <PropertyGroup>
    <PlatformVersion Condition="'$(PlatformVersion)' == ''">3.1.0</PlatformVersion>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">$(PlatformVersion)</VersionPrefix>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">3.1.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <Authors>Phong Võ, ZeroPlatform Contributors</Authors>
    <Company>ZeroUniverse</Company>
    <Copyright>Copyright © 2026 Phong Võ</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kzxl/ZeroPlatform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kzxl/ZeroPlatform.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <LangVersion>latest</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
