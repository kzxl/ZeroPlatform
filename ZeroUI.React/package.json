{
  "name": "@zeroui/react",
  "version": "1.0.1",
  "description": "Modern React component suite for ZeroPlatform with unified tokens, headless state models, and industrial-grade controls.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kzxl/ZeroUI.React.git"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "keywords": [
    "react",
    "zeroui",
    "design-system",
    "components",
    "industrial",
    "process-map",
    "button-group"
  ],
  "author": "Phong Võ",
  "license": "MIT"
}
