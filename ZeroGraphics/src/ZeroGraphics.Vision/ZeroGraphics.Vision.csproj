<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <Description>Industrial Machine Vision, Sub-pixel Normalized Cross-Correlation (NCC) Template Matching, Edge Calipers, Geometric Line/Circle Fitting, and 8-way Connected Component Blob Analysis for .NET.</Description>
    <PackageTags>machine-vision;template-matching;ncc;metrology;caliper;circle-fit;line-fit;blob-analysis;subpixel;industrial-inspection;aoi</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kzxl/ZeroGraphics</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroGraphics.Core\ZeroGraphics.Core.csproj" />
    <ProjectReference Include="..\ZeroGraphics.Imaging\ZeroGraphics.Imaging.csproj" />
    <ProjectReference Include="..\..\..\ZeroVector\src\ZeroVector.Core\ZeroVector.Core.csproj" Condition="Exists('..\..\..\ZeroVector\src\ZeroVector.Core\ZeroVector.Core.csproj')" />
    <PackageReference Include="ZeroVector.Core" Version="1.1.0" Condition="!Exists('..\..\..\ZeroVector\src\ZeroVector.Core\ZeroVector.Core.csproj')" />
  </ItemGroup>
</Project>
