<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows;net9.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <Description>High-performance image processing, computer vision primitives, Otsu binarization, adaptive integral thresholding, separable Gaussian blur, Sobel edge detection, and morphology for .NET.</Description>
    <PackageTags>image-processing;computer-vision;otsu;thresholding;sobel;gaussian;morphology;directx;zero-allocation</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kzxl/ZeroUI</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroGraphics.Core\ZeroGraphics.Core.csproj" />
    <ProjectReference Include="..\ZeroGraphics.DirectX\ZeroGraphics.DirectX.csproj" />
  </ItemGroup>
</Project>
