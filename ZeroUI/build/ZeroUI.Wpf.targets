<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- ZeroUI WPF Visual Studio XAML Designer Integration Targets -->
  <!-- Automatically resolves ZeroUI.Wpf.Design.dll in Visual Studio XAML Designer -->
  <ItemGroup Condition="'$(DesignTimeBuild)' == 'true' Or '$(BuildingInsideVisualStudio)' == 'true'">
    <ReferencePath Include="$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\ZeroUI.Wpf.Design.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\ZeroUI.Wpf.Design.dll')" />
  </ItemGroup>
</Project>
