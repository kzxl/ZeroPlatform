<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroUI.WinForms.Media</RootNamespace>
    <AssemblyName>ZeroUI.WinForms.Media</AssemblyName>
    <Description>ZeroUI WinForms Media - High-performance GPU accelerated image viewer, photo studio canvas, and media inspection controls.</Description>
    <PackageTags>winforms;media;imageviewer;photostudio;d3d11;directx;zoom;pan;pixel-grid</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ZeroUI.Core\ZeroUI.Core.csproj" />
    <ProjectReference Include="..\ZeroUI.WinForms.Common\ZeroUI.WinForms.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.Core\ZeroGraphics.Core.csproj" />
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.Imaging\ZeroGraphics.Imaging.csproj" />
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.DirectX\ZeroGraphics.DirectX.csproj" />
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.Direct2D\ZeroGraphics.Direct2D.csproj" />
    <ProjectReference Include="..\..\..\..\ZeroOcr\src\ZeroOcr.Core\ZeroOcr.Core.csproj" />
  </ItemGroup>
</Project>
