<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroUI.WinForms.Charts</RootNamespace>
    <AssemblyName>ZeroUI.WinForms.Charts</AssemblyName>
    <Description>ZeroUI WinForms Charts - High-performance 2D/3D charts, oscilloscope, spectrogram, and DirectX renderers.</Description>
    <PackageTags>winforms;charts;directx;oscilloscope;spectrogram;visualization</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ZeroUI.Core\ZeroUI.Core.csproj" />
    <ProjectReference Include="..\ZeroUI.WinForms.Common\ZeroUI.WinForms.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroGraphics.Core" Version="1.7.0" />
    <PackageReference Include="ZeroGraphics.DirectX" Version="1.7.0" />
    <PackageReference Include="ZeroGraphics.Direct2D" Version="1.7.0" />
    <PackageReference Include="ZeroGraphics.Waveform" Version="1.7.0" />
  </ItemGroup>
</Project>
