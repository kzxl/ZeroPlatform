<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroUI.WinForms</RootNamespace>
    <AssemblyName>ZeroUI.WinForms.Common</AssemblyName>
    <Description>ZeroUI WinForms Common - Shell, Base, Theming, Primitives, Buttons, Panels, Layout, and Overlays.</Description>
    <PackageTags>winforms;theme;controls;shell;ribbon;docking</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ZeroUI.Core\ZeroUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.Core\ZeroGraphics.Core.csproj" />
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.DirectX\ZeroGraphics.DirectX.csproj" />
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.Direct2D\ZeroGraphics.Direct2D.csproj" />
    <ProjectReference Include="..\..\..\..\ZeroGraphics\src\ZeroGraphics.Waveform\ZeroGraphics.Waveform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\*.bmp" />
  </ItemGroup>
</Project>
