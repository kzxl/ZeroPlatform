<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroUI.WinForms.Documents</RootNamespace>
    <AssemblyName>ZeroUI.WinForms.Documents</AssemblyName>
    <Description>ZeroUI WinForms Documents - Reporting, print previews, spreadsheets, and document viewers.</Description>
    <PackageTags>winforms;reporting;documents;pdf;spreadsheet</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ZeroUI.Core\ZeroUI.Core.csproj" />
    <ProjectReference Include="..\ZeroUI.WinForms.Common\ZeroUI.WinForms.Common.csproj" />
    <ProjectReference Include="..\ZeroUI.WinForms.Editors\ZeroUI.WinForms.Editors.csproj" />
    <ProjectReference Include="..\ZeroUI.WinForms.Data\ZeroUI.WinForms.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroGraphics.Core" Version="1.7.0" />
  </ItemGroup>

</Project>
