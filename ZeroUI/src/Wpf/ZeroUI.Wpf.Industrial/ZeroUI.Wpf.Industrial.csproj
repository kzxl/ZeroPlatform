<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroUI.Wpf.Industrial</RootNamespace>
    <AssemblyName>ZeroUI.Wpf.Industrial</AssemblyName>
    <Description>ZeroUI WPF Industrial - SCADA gauges, ISA-18.2 alarms, P&amp;ID mimics, and domain modules.</Description>
    <PackageTags>wpf;scada;hmi;gauges;alarms;pid;industrial-automation</PackageTags>
    <Authors>Phong Võ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ZeroUI.Core\ZeroUI.Core.csproj" />
    <ProjectReference Include="..\ZeroUI.Wpf.Common\ZeroUI.Wpf.Common.csproj" />
    <ProjectReference Include="..\ZeroUI.Wpf.Editors\ZeroUI.Wpf.Editors.csproj" />
    <ProjectReference Include="..\ZeroUI.Wpf.Charts\ZeroUI.Wpf.Charts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroGraphics.Core" Version="1.7.0" />
    <PackageReference Include="ZeroGraphics.Direct2D" Version="1.7.0" />
  </ItemGroup>

</Project>
