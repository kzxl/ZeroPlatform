<Window x:Class="ZeroUI.Wpf.Theme.SkinStudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroUI Skin Studio - Dynamic Palette Generator"
        Width="820" Height="620"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ZeroUI.BgPrimary}"
        Foreground="{DynamicResource ZeroUI.TextPrimary}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,16" BorderBrush="{DynamicResource ZeroUI.BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎨 ZeroUI Skin Studio" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextPrimary}" />
                    <TextBlock Text="Seed Palette Generator, Dynamic Contrast Engine &amp; JSON Skin Persistence"
                               FontSize="12" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource ZeroUI.BgCard}" BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                        BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <TextBlock x:Name="TxtContrastRatio" Text="WCAG Contrast: 14.2:1 (AAA)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.SuccessAccent}" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. QUICK PALETTE PRESET SWATCHES -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="QUICK PRESET ACCENTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8" />
            <WrapPanel x:Name="PanelPresets" Orientation="Horizontal" />
        </StackPanel>

        <!-- 3. MAIN EDITOR SPLIT (SETTINGS & LIVE PREVIEW) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: INPUT CONTROLS -->
            <Border Grid.Column="0" Background="{DynamicResource ZeroUI.BgCard}" BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SKIN ATTRIBUTES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" Margin="0,0,0,12" />

                        <!-- Display Name -->
                        <TextBlock Text="Display Name" FontSize="12" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtDisplayName" Text="Custom Brand" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12" TextChanged="OnInputChanged" />

                        <!-- System Name -->
                        <TextBlock Text="Identifier (Machine Name)" FontSize="12" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtSkinName" Text="custom_brand" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12" TextChanged="OnInputChanged" />

                        <!-- Mode Switch -->
                        <TextBlock Text="Background Mode" FontSize="12" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="RbDarkMode" Content="🌙 Dark Mode" IsChecked="True" Margin="0,0,16,0" Checked="OnModeChanged" />
                            <RadioButton x:Name="RbLightMode" Content="☀️ Light Mode" Checked="OnModeChanged" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ZeroUI.BorderSubtle}" Margin="0,0,0,16" />

                        <TextBlock Text="SEED PALETTE COLORS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" Margin="0,0,0,12" />

                        <!-- Primary Accent -->
                        <TextBlock Text="Primary Seed Color (Hex)" FontSize="12" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BoxPrimaryColor" Grid.Column="0" Height="34" CornerRadius="4" BorderBrush="{DynamicResource ZeroUI.BorderDefault}" BorderThickness="1" Background="#6366F1" />
                            <TextBox x:Name="TxtPrimaryHex" Grid.Column="2" Text="#6366F1" Height="34" VerticalContentAlignment="Center" TextChanged="OnInputChanged" />
                        </Grid>

                        <!-- Secondary Accent -->
                        <TextBlock Text="Secondary Accent (Hex)" FontSize="12" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BoxSecondaryColor" Grid.Column="0" Height="34" CornerRadius="4" BorderBrush="{DynamicResource ZeroUI.BorderDefault}" BorderThickness="1" Background="#EC4899" />
                            <TextBox x:Name="TxtSecondaryHex" Grid.Column="2" Text="#EC4899" Height="34" VerticalContentAlignment="Center" TextChanged="OnInputChanged" />
                        </Grid>

                        <!-- Re-generate Button -->
                        <Button Content="⚡ Re-generate Palette" Height="36" FontWeight="SemiBold" Click="BtnRegenerate_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: LIVE PREVIEW CANVAS -->
            <Border Grid.Column="2" x:Name="PreviewContainer" Background="{DynamicResource ZeroUI.BgPrimary}" BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LIVE PREVIEW" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,16" />

                    <!-- Simulated Component Sandbox -->
                    <StackPanel Grid.Row="1">
                        <!-- Mock Card -->
                        <Border x:Name="PrevCard" Background="{DynamicResource ZeroUI.BgCard}" BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="PrevTitle" Text="Customer Order Batch #9401" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextPrimary}" />
                                <TextBlock x:Name="PrevSubtitle" Text="Status: Production Line 4 - High Priority" FontSize="12" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,4,0,12" />

                                <!-- Simulated Data Row Selection (High Contrast Check) -->
                                <Border x:Name="PrevSelection" Background="{DynamicResource ZeroUI.SelectionBackground}" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock x:Name="PrevSelText" Text="Selected Row: Steel Coil Type-A (High Contrast WCAG AAA)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ZeroUI.SelectionForeground}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Interactive Controls Row -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PrevInput" Grid.Column="0" Text="Search barcode / SKU..." Height="34" VerticalContentAlignment="Center" />
                                    <Button x:Name="PrevBtnPrimary" Grid.Column="2" Content="Primary Action" Height="34" Padding="16,0" FontWeight="SemiBold" />
                                    <Button x:Name="PrevBtnOutline" Grid.Column="4" Content="Cancel" Height="34" Padding="16,0" Background="Transparent" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Color Swatch Strip -->
                        <TextBlock Text="GENERATED TOKEN SWATCHES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8" />
                        <UniformGrid x:Name="SwatchGrid" Rows="1" Height="36" Margin="0,0,0,16" />

                        <!-- Status Chips -->
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ChipSuccess" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Background="#16A34A">
                                <TextBlock Text="Success: Ready" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                            <Border x:Name="ChipWarning" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Background="#D97706">
                                <TextBlock Text="Warning: 85% Load" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                            <Border x:Name="ChipDanger" CornerRadius="12" Padding="10,4" Background="#DC2626">
                                <TextBlock Text="Danger: Alert" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. BOTTOM ACTION TOOLBAR -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,16,0,0" BorderBrush="{DynamicResource ZeroUI.BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Import / Export Files -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="📂 Import JSON..." Height="36" Padding="14,0" Margin="0,0,8,0" Click="BtnImport_Click" />
                    <Button Content="💾 Export JSON..." Height="36" Padding="14,0" Click="BtnExport_Click" />
                </StackPanel>

                <!-- Right: Save / Apply / Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="➕ Save to Skin Catalog" Height="36" Padding="14,0" Margin="0,0,8,0" Click="BtnSaveToCatalog_Click" />
                    <Button x:Name="BtnApplyLive" Content="⚡ Apply Live to App" Height="36" Padding="18,0" FontWeight="Bold" Margin="0,0,8,0" Click="BtnApplyLive_Click" />
                    <Button Content="Close" Height="36" Padding="14,0" Background="Transparent" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
