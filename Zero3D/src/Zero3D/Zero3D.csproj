<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Enterprise Pure C# 3D Graphics, Scene Graph, Mesh Primitives, Software Rasterizer (Z-Buffer), Point Cloud Voxel Filtering, glTF/OBJ/STL/PLY Loaders for .NET.</Description>
    <PackageTags>3d;graphics;scenegraph;rasterizer;zbuffer;pointcloud;ply;gltf;obj;stl;cad;mesh;simulation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroPrimitives.Core" Version="1.7.0" />
  </ItemGroup>
</Project>
