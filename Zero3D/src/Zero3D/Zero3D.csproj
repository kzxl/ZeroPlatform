<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Enterprise Pure C# 3D Graphics, Scene Graph, Mesh Primitives, glTF/OBJ/STL Loaders &amp; Simulation Engine for .NET.</Description>
    <PackageTags>3d;graphics;scenegraph;gltf;obj;stl;cad;mesh;pbr;camera;simulation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ZeroPrimitives\src\ZeroPrimitives.Core\ZeroPrimitives.Core.csproj" />
  </ItemGroup>
</Project>
