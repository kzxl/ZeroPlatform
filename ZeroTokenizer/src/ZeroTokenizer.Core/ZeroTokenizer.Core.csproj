<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <Description>Pure C# high-speed Byte-Pair Encoding (BPE), Tiktoken, and LLM context token budgeter engine with zero-allocation memory discipline for .NET.</Description>
    <PackageTags>tokenizer;bpe;tiktoken;gpt4;llama;tokens;token-counter;ai;llm;context-window;budget;zero-allocation</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroPrimitives.Core" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ZeroTokenizer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
