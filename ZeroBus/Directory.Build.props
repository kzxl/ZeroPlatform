<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Condition="$(MSBuildProjectName.Contains('Tests')) Or $(MSBuildProjectName.Contains('Benchmarks')) Or $(MSBuildProjectName.Contains('Samples')) Or $(MSBuildProjectName.Contains('Demo'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Condition="Exists('README.md')" Include="README.md" Pack="true" PackagePath="\" />
    <None Condition="!Exists('README.md') And Exists('$(MSBuildThisFileDirectory)README.md')" Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
