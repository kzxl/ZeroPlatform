<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <Description>Pure C# Industrial Motion Fieldbus: Real-Time CAN / CANopen (CiA 301 &amp; CiA 402 Servo Drive Profile), EtherCAT Master (ESM, CoE Mailbox, Cyclic Synchronous Position CSP) for .NET.</Description>
    <PackageTags>fieldbus;can;canopen;ethercat;cia301;cia402;motion-control;servo;csp;cyclic-synchronous;pure-csharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroPrimitives.Core" Version="1.7.0" />
    <PackageReference Include="ZeroConcurrency" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ZeroBus.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
