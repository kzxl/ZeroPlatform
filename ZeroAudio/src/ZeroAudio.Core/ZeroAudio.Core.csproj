<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>ZeroAudio</RootNamespace>
    <AssemblyName>ZeroAudio.Core</AssemblyName>
    <PackageId>ZeroAudio.Core</PackageId>
    <Product>ZeroAudio</Product>
    <Description>Sovereign Pure C# Audio Engineering &amp; DSP Engine for .NET: WAV/RIFF streaming, high-speed resampling, channel routing, dynamic compression, biquad equalization, signal generation, and low-latency audio mixing with zero external unmanaged dependencies.</Description>
    <PackageTags>audio;dsp;wav;riff;pcm;resampling;equalizer;compressor;mixer;synth;pure-csharp;zero-dependency;zeroplatform</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroPrimitives.Core" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
  </ItemGroup>

</Project>
