<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ZeroSystem</RootNamespace>
    <AssemblyName>ZeroSystem.Core</AssemblyName>
    <Product>ZeroSystem</Product>
    <Description>Sovereign Windows Native, Kernel P/Invoke, DWM Desktop, and OS Internals Subsystem for ZeroPlatform with zero external dependencies.</Description>
  </PropertyGroup>

</Project>
